# Copy to .env and fill in. Nothing here is required for a default local layout:
#   indonesian_dev/ next to the repo, no Hub publishing.
#
#   cp .env.example .env
#
# The notebook and `lit_jv.data.resolve_dev_dir` load `.env` automatically.
# Already-exported variables win, so a RunPod secret overrides this file.
# Never commit `.env` — it can hold HF_TOKEN.

# ---------------------------------------------------------------------------
# Paths  (needed on RunPod if the data is not at the repo default)
# ---------------------------------------------------------------------------

# Directory that contains metadata.tsv and clips/. Gitignored; a git clone
# does not include it.
# LIT_DEV_DIR=/workspace/Lost_In_Transcription_Indonesian_Javanese_Track/indonesian_dev

# Extra Javanese corpus for LoRA stage 1. Leave unset to train on dev only.
# LIT_JEMBER=/workspace/data/jember

# ---------------------------------------------------------------------------
# Reproducibility
# ---------------------------------------------------------------------------

LIT_SEED=3407
LIT_DETERMINISTIC=0

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# Checkpoint used for decoding. Local path, or a Hub repo id.
# After §10, artifacts/merged-qwen3asr/ is picked up automatically.
LIT_MODEL=Qwen/Qwen3-ASR-1.7B

# Base weights the LoRA is trained on. Usually the same family as LIT_MODEL.
LIT_BASE_MODEL=Qwen/Qwen3-ASR-1.7B

# Pull a finished checkpoint from the Hub instead of training (needs network).
# LIT_HF_CHECKPOINT=your-name/lit-jv-qwen3asr-lora
# LIT_HF_SUBFOLDER=merged
# LIT_HF_REVISION=

# ---------------------------------------------------------------------------
# Hugging Face Hub  (optional — leave blank to keep everything local)
# ---------------------------------------------------------------------------

# Write token. Create at https://huggingface.co/settings/tokens
# Never pasted into a notebook cell, never logged, never written into an artefact.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repo to publish adapters, TensorBoard event files, and the run manifest.
# LIT_HF_REPO=your-name/lit-jv-qwen3asr-lora
LIT_HF_PRIVATE=1
LIT_HF_UPLOAD_MERGED=0

# ---------------------------------------------------------------------------
# Notebook GPU gates
# ---------------------------------------------------------------------------

# Set to 1 to force the cached / simulated path even when CUDA is present.
LIT_SKIP_DECODE=0
LIT_SKIP_TRAIN=0

# Time-budget estimate in §12. LIT_CLIPS_PER_S overrides the measured rate.
LIT_TEST_CLIPS=1000
# LIT_CLIPS_PER_S=1.8

# ---------------------------------------------------------------------------
# Competition container only  (the leaderboard sets these; do not set them
# in the notebook. Listed so a local dry-run is documented.)
# ---------------------------------------------------------------------------

# LIT_DATA_DIR=/data
# LIT_SUBMISSION_PATH=/submission/submission.csv
# LIT_CONFIG_PATH=/code/submission_config.json
