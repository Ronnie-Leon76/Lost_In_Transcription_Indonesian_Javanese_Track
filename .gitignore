# and clips/ without a separate rsync.
jember/
nahuatl_dev/
spanish_english_dev/
tetelancingo_nahuatl/

# Downloaded competition data and official submission-format CSVs are local only.
data/**
!data/README.md
!data/**/.gitkeep
submission_formats/**/submission_format.csv
*.tar.gz
.env
*.token
