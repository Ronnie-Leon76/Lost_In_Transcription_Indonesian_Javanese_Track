{
 "model_dir": "model",
 "backend": "vllm",
 "time_budget_s": 6300,
 "chunk_size": 48,
 "passes": [
  {
   "name": "p1-style-glossary",
   "prose": "codeswitch_style",
   "glossary": true,
   "max_glossary_terms": 96,
   "force_language": "Indonesian",
   "temperature": 0.0
  },
  {
   "name": "p2-style-noglossary",
   "prose": "codeswitch_style",
   "glossary": false,
   "max_glossary_terms": 96,
   "force_language": "Indonesian",
   "temperature": 0.0
  },
  {
   "name": "p3-verbatim-freelid",
   "prose": "verbatim",
   "glossary": true,
   "max_glossary_terms": 96,
   "force_language": null,
   "temperature": 0.0
  }
 ],
 "combiner": "rover",
 "combiner_by_n": {
  "2": "rover",
  "3": "rover"
 },
 "rover": {
  "null_penalty": 1.0,
  "insertion_threshold": 0.5
 },
 "fallback": {
  "enabled": true,
  "min_avg_logprob": -0.85,
  "max_length_z": 3.0,
  "sampling_draws": 4,
  "sampling_temperature": 0.4,
  "split_long_clips": true,
  "max_rescue_fraction": 0.15
 },
 "length_prior": {
  "mean": 1.885,
  "std": 0.264
 },
